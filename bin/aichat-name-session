#!/bin/bash

: ${AICHAT_COLOR_QUERY='[03;32m'}
: ${AICHAT_COLOR_MESSAGE='[03m'}
: ${AICHAT_COLOR_RESET='[0m'}
: ${AICHAT_NAMED_SESSION_DIR:=${XDG_CONFIG_HOME:-${HOME}/.config}/aichat/sessions}
: ${AICHAT_UNNAMED_SESSION_DIR:=${AICHAT_NAMED_SESSION_DIR}/_}

printUsage()
{
    cat <<HELPTEXT
Promote the unnamed session in UNNAMED-SESSION-FILE to a named session by asking
the user for a session, with an autogenerated title as the default.
HELPTEXT
    echo
    printf 'Usage: %q %s\n' "$(basename "$1")" 'UNNAMED-SESSION-FILE [-?|-h|--help]'
}

case "$1" in
    --help|-h|-\?)	shift; printUsage "$0"; exit 0;;
esac
if [ $# -ne 1 ]; then
    printUsage "$0" >&2
    exit 2
fi
unnamedSessionFilespec="${1:?}"; shift
[ -e "$unnamedSessionFilespec" ] || [[ "$unnamedSessionFilespec" = */* ]] || unnamedSessionFilespec="${AICHAT_UNNAMED_SESSION_DIR}/${unnamedSessionFilespec}"
if [ ! -e "$unnamedSessionFilespec" ]; then
    printf >&2 'ERROR: Unnamed session file not found: %s\n' "$unnamedSessionFilespec"
    exit 2
fi

autogeneratedTitle="$(
    yq -r '.messages | map(select(.role == "user")) | .[0].content' "$unnamedSessionFilespec" \
	| aichat --role %create-title%
    )"
if title="$(userquery -p $'\n'"${AICHAT_COLOR_QUERY}Session name:${AICHAT_COLOR_RESET} " -e -i "$autogeneratedTitle")" \
    && [ -n "$title" ]
then
    namedSessionFilespec="${AICHAT_NAMED_SESSION_DIR}/${title// /-}.yaml"
    mv -- "$unnamedSessionFilespec" "$namedSessionFilespec" \
	&& printf '%s\n' "$namedSessionFilespec"
else
    exit 4
fi
