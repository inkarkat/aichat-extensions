#!/bin/bash
shopt -qs extglob

: ${AICHAT_COLOR_QUERY='[03;32m'}
: ${AICHAT_COLOR_MESSAGE='[03m'}
: ${AICHAT_COLOR_RESET='[0m'}

: ${AICHAT_MODEL_NANO:=openai:gpt-5-nano}
: ${AICHAT_MODEL_MINI:=openai:gpt-5-mini}
: ${AICHAT_MODEL_PRO:=openai:gpt-5.2}

: ${AICHAT_NAMED_SESSION_DIR:=${XDG_CONFIG_HOME:-${HOME}/.config}/aichat/sessions}
: ${AICHAT_UNNAMED_SESSION_DIR:=${AICHAT_NAMED_SESSION_DIR}/_}

# Allow definition of aichat aliases by putting an executable "aichat-foo"
# somewhere in the PATH.
typeset aichatAlias="aichat-$1"
if type -t "$aichatAlias" >/dev/null; then
    shift; eval $aichatAlias '"$@"'
    exit $?
fi

askForSessionName()
{
    local unnamedSessionFilespec; unnamedSessionFilespec="$(lastFiles -- "$AICHAT_UNNAMED_SESSION_DIR")" || return
    local namedSessionFilespec; namedSessionFilespec="$(aichat-name-session "$unnamedSessionFilespec")" \
	&& printf >&2 '%sSession is saved as%s %s\n' "$AICHAT_COLOR_MESSAGE" "$AICHAT_COLOR_RESET" "$namedSessionFilespec" \
	|| printf >&2 '%sUnnamed session is saved at%s %s\n' "$AICHAT_COLOR_MESSAGE" "$AICHAT_COLOR_RESET" "$unnamedSessionFilespec"
}

autoNameSession()
{
    local unnamedNamedSessionFilespec="${1:?}"; shift
    local namedSessionFilespec; if namedSessionFilespec="$(aichat-name-session "$unnamedNamedSessionFilespec")"; then
	printf >&2 '%sSession is saved as%s %s\n' "$AICHAT_COLOR_MESSAGE" "$AICHAT_COLOR_RESET" "$namedSessionFilespec"
    else
	unnamedSessionFilespec="${AICHAT_UNNAMED_SESSION_DIR}/$(date +%Y%m%d-%H%M%S).yaml" \
	    && mv -- "$unnamedNamedSessionFilespec" "$unnamedSessionFilespec" \
	    && printf >&2 '%sUnnamed session is saved at%s %s\n' "$AICHAT_COLOR_MESSAGE" "$AICHAT_COLOR_RESET" "$unnamedSessionFilespec"
	fi
}

printUsage()
{
    command aichat --help 2>&1 | sed \
	-e '/^ *\(-s, --session\)/i\
  -n, --no-session		       Do not record this chat'
}

# Create an unnamed session by default, unless a session name is passed or the
# user (or the built-in completion) just queries something.
# Note: In aichat, session means that the context between inputs is preserved,
# but to me, using a single interactive invocation where each input is separate
# doesn't make any sense. So to me, "no session" means that the context is still
# preserved, but the session is ephemeral and won't be saved.
isUseSession=t
isNamedSession=
typeset -a sessionArgs=(--session temp)

hasFileArgs=
typeset -a args=()
typeset -a launcher=(command)
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printUsage "$0"; exit 0;;
	--no-session|-n)
			shift; isUseSession=
			# To turn off persistence while keeping context preservation within one
			# invocation (what aichat calls "session"), we can use a temporary session and
			# never persist it. For aichat to not ask for a session name, we need to disable
			# session saving. Unfortunately, there's no easy override; we have to manipulate
			# the configuration.
			launcher=(withTempfile
			    --exec cp -- "${XDG_CONFIG_HOME:-${HOME}/.config}/aichat/config.yaml" '{}' \;
			    --exec ASSIGNMENT_OPERATOR=': ' addOrUpdateAssignment --in-place --lhs save_session --rhs false '{}' \;
			    -- AICHAT_CONFIG_FILE='{}'
			)
			;;

	-+([hV])|--@(info|sync-models|list-*|help|version))
			sessionArgs=();;&
	-f|--file=*|--file)
			hasFileArgs=t;;&

	--session|-s)	sessionArgs=("$1" "${2?}"); shift; shift; isNamedSession=t;;
	-+([ecShV]))	args+=("$1"); shift;;
	--@(empty-session|save-session|rebuild-rag|execute|code|no-stream|dry-run|info|sync-models|list-*|help|version))
			args+=("$1"); shift;;
	-[mraf])	args+=("$1" "${2?}"); shift; shift;;
	--@(model|prompt|role|agent|rag|macro|serve|file)=*)
			args+=("$1"); shift;;
	--@(model|prompt|role|session|agent|rag|macro|serve|file))
			args+=("$1" "${2?}"); shift; shift;;

	--@(nano|mini|pro))
			# Shortcut options for favorite models at different cost levels.
			modelVar="${1#--}"; modelVar="AICHAT_MODEL_${modelVar^^}"; shift
			args+=(--model "${!modelVar}")
			;;
	--)		args+=("$1"); shift; break;;
	*)		break;;
    esac
done

isNonInteractiveSession=; [ $# -gt 0 -o "$hasFileArgs" ] && isNonInteractiveSession=t
if [ "$isUseSession" ] && [ "$isNonInteractiveSession" ] && [ ${#sessionArgs[@]} -gt 0 ]; then
    # DWIM: Enable automatic saving of a non-interactive session (i.e. one that has
    # FILE(s) or TEXT passed).
    sessionArgs+=(--save-session)
fi

"${launcher[@]}" aichat "${sessionArgs[@]}" "${args[@]}" "$@" || exit $?

if [ "$isUseSession" ] && [ ! "$isNamedSession" ]; then
    if [ "$isNonInteractiveSession" ]; then
	# DWIM: Offer to store the unnamed session under an auto-generated title.
	askForSessionName
    elif unnamedNamedSessionFilespec="${AICHAT_NAMED_SESSION_DIR}/..yaml" && [ -r "$unnamedNamedSessionFilespec" ]; then
	# DWIM: Allow interactive session naming as just ".' and then auto-name the
	# session.
	autoNameSession "$unnamedNamedSessionFilespec"
    fi
fi
