#!/bin/bash
shopt -qs extglob

: ${AICHAT_MODEL_NANO:=openai:gpt-5-nano}
: ${AICHAT_MODEL_MINI:=openai:gpt-5-mini}
: ${AICHAT_MODEL_PRO:=openai:gpt-5.2}

# Allow definition of aichat aliases by putting an executable "aichat-foo"
# somewhere in the PATH.

typeset aichatAlias="aichat-$1"
if type -t "$aichatAlias" >/dev/null; then
    shift; eval $aichatAlias '"$@"'
else
    # Create an unnamed session by default, unless a session name is passed or the
    # user (or the built-in completion) just queries something.
    typeset -a sessionArgs=(--session temp)
    hasFileArgs=
    typeset -a args=()
    while [ $# -ne 0 ]
    do
	case "$1" in
	    -+([hV])|--@(info|sync-models|list-*|help|version))
			sessionArgs=();;&
	    -f|--file=*|--file)
			hasFileArgs=t;;&

	    --session|-s)
			sessionArgs=("$1" "${2?}"); shift; shift;;
	    -+([ecShV]))
			args+=("$1"); shift;;
	    --@(empty-session|save-session|rebuild-rag|execute|code|no-stream|dry-run|info|sync-models|list-*|help|version))
			args+=("$1"); shift;;
	    -[mraf])	args+=("$1" "${2?}"); shift; shift;;
	    --@(model|prompt|role|agent|rag|macro|serve|file)=*)
			args+=("$1"); shift;;
	    --@(model|prompt|role|session|agent|rag|macro|serve|file))
			args+=("$1" "${2?}"); shift; shift;;

	    --@(nano|mini|pro))
			# Shortcut options for favorite models at different cost levels.
			modelVar="${1#--}"; modelVar="AICHAT_MODEL_${modelVar^^}"; shift
			args+=(--model "${!modelVar}")
			;;
	    --)		args+=("$1"); shift; break;;
	    *)		break;;
	esac
    done
    if [ $# -gt 0 -o "$hasFileArgs" ] && [ ${#sessionArgs[@]} -gt 0 ]; then
	# DWIM: Enable automatic saving of a non-interactive session (i.e. one that has
	# FILE(s) or TEXT passed).
	sessionArgs+=(--save-session)
    fi

    command aichat "${sessionArgs[@]}" "${args[@]}" "$@"
fi
